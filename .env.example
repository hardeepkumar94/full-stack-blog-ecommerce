# Copy this file to .env.local and replace the placeholders.
# Never commit real database credentials.
MYSQL_HOST="your-mysql-host"
MYSQL_HOST_IP="your-mysql-ip"
MYSQL_PORT="3306"
MYSQL_DATABASE="your-database-name"
MYSQL_USER="your-database-user"
MYSQL_PASSWORD="your-database-password"

# URL-encode special characters in the username and password.
DATABASE_URL="mysql://your-user:your-password@your-mysql-host:3306/your-database-name"

# Generate with: npm exec auth secret
AUTH_SECRET="replace-with-a-random-secret"

# Hostinger Email SMTP. Keep the real password only in .env.local and Vercel.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="no-reply@your-domain.com"
SMTP_PASSWORD="your-mailbox-or-app-password"
EMAIL_FROM="no-reply@your-domain.com"
